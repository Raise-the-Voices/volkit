server {
    listen 80;
    server_name {{ volkit_host }};

    location /api/live/ {
        proxy_pass http://127.0.0.1:{{ volkit_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ volkit_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
