# VolKit: a baobab frame. Shared names: CONTRACT.md section 10.
SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://volkit:volkit@localhost:5432/volkit
ALLOWED_HOSTS=localhost,127.0.0.1

# Sign-in. Register a confidential client at the provider with redirect URI
# https://<this host>/auth/linkedtrust/callback
OIDC_ISSUER=https://live.linkedtrust.us
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_PROVIDERS=linkedtrust

# Origins of fronds and other pages that fetch this frame's API with credentials.
EMBED_ORIGINS=

# Shared with roots that ask this frame who is in which org. Empty: refused.
S2S_TOKEN=

# Server-sent events at /api/live/. Needs Postgres and uvicorn; on SQLite it is off
# whatever this says.
LIVE=true

# --- VolKit. Unset: that card is off. ---
# Ghost site, e.g. https://raisethevoices.org. Content key: team articles. Admin key (id:secret): my articles.
VOLKIT_GHOST_URL=
VOLKIT_GHOST_CONTENT_KEY=
VOLKIT_GHOST_ADMIN_KEY=
# Cases app, e.g. https://cases.raisethevoices.org
VOLKIT_CASES_URL=
